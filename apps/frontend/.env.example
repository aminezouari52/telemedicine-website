# --- Core ---
# Backend URL. Must match the backend's PORT locally, or its public URL in production.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_V1_URL=http://localhost:8000/v1

# --- LiveKit (optional — video consultations; needs the backend's LIVEKIT_* keys too) ---
# NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# --- Google Gemini (optional — used server-side by the Next.js AI routes in src/app/api/ai/*;
# needs the backend's GEMINI_API_KEY too) ---
# GEMINI_API_KEY=your-gemini-api-key

# --- Clerk (required — authentication) ---
# Clerk dashboard → Configure → API keys. Use the same Clerk application as the backend.
# Sign-in/sign-up URLs and redirects are set in code (src/constants/auth.js).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key
CLERK_SECRET_KEY=sk_test_your_key

# --- Stripe (optional — payments use the hosted Stripe Checkout page; this key is
# only needed if you add Stripe Elements / client-side Stripe.js) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key

# --- Demo mode (optional — only for a public demo deployment) ---
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_DEMO_DOCTOR_EMAIL=demo.doctor@example.com
NEXT_PUBLIC_DEMO_PATIENT_EMAIL=demo.patient@example.com
NEXT_PUBLIC_DEMO_PASSWORD=choose-a-unique-demo-password
