# --- Core ---
NODE_ENV=development
PORT=8000
# Frontend origin, no trailing slash. Sign-in fails if it's wrong (Clerk only accepts
# tokens issued for this origin), and Stripe redirects here after payment.
WEB_FRONTEND_URL=http://localhost:3000

# --- MongoDB (required) ---
# Local:  mongodb://127.0.0.1:27017/your-db-name
# Atlas:  mongodb+srv://DB_USERNAME:DB_PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://DB_USERNAME:DB_PASSWORD@your-cluster.mongodb.net/?retryWrites=true&w=majority

# --- Clerk (required — authentication) ---
# Clerk dashboard → Configure → API keys. Use the same Clerk application as the frontend.
CLERK_SECRET_KEY=sk_test_your_key
# Optional: Clerk dashboard → Configure → API keys → JWT public key (PEM). Lets the
# backend verify session tokens without a network call to Clerk.
# CLERK_JWT_KEY=-----BEGIN PUBLIC KEY-----...-----END PUBLIC KEY-----

# --- Optional services ---
# Each service below turns its feature on once all of its variables are set.
# Leave a group commented out to run without it (see docs/configuration.md).

# Cloudinary — doctor profile photos. Off: photo uploads are hidden.
# CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# LiveKit — video and chat in consultations. Off: consultation rooms can't be joined.
# Also set NEXT_PUBLIC_LIVEKIT_URL in the frontend.
# LIVEKIT_API_KEY=your-livekit-api-key
# LIVEKIT_API_SECRET=your-livekit-api-secret

# Google Gemini — AI assistant and embeddings. Off: the AI assistant is hidden.
# Also set GEMINI_API_KEY in the frontend.
# GEMINI_API_KEY=your-gemini-api-key
# AI assistant messages each user may send per hour (default 30)
# AI_MESSAGES_PER_HOUR=30

# Stripe — paid consultations. Off: every consultation is booked for free.
# STRIPE_WEBHOOK_SECRET comes from `stripe listen` locally, or the webhook endpoint
# settings in the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_your_key
# STRIPE_WEBHOOK_SECRET=whsec_your_key

# --- Admin seed account (required by `pnpm -F=backend seed:admin` — no defaults) ---
# The password must not be in a public breach list, or Clerk rejects it.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# --- Demo accounts (optional — only for a public demo deployment)
DEMO_DOCTOR_EMAIL=demo.doctor@example.com
DEMO_PATIENT_EMAIL=demo.patient@example.com
DEMO_PASSWORD=choose-a-unique-demo-password
